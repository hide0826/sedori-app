{
  "manifest_version": 3,
  "name": "HIRIO メルカリ撮影",
  "version": "1.0.2",
  "description": "ログイン済みのChromeで、HIRIOの情報撮影を行います。",
  "permissions": ["tabs", "scripting", "debugger"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
